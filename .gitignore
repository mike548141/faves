.DS_Store
*.icloud

# Node is dev-tooling only (tests, Lighthouse). There are no
# dependencies; if anyone runs `npm install`, keep its output out.
node_modules/
package-lock.json

# Secrets — the Cloudflare token lives in the environment, never in the
# repo. Ignore common local token/env files just in case.
.env
.env.*
*.token
tools/.cf-token

# Raw menu scans, board photos and Notes exports — transcribed into
# site/data, never shipped. Keep the folder structure + README; ignore
# the drops themselves.
intake/**
!intake/README.md
!intake/menus/
!intake/menus/.gitkeep
!intake/recipes/
!intake/recipes/.gitkeep

# Claude Code config is local tooling, not part of the shipped product —
# each machine/user manages its own; keep it out of this public repo.
.claude/

# Python bytecode from the tools/ scripts — generated on import, never
# part of the product. (Two .pyc files reached the tree before this line
# existed; untracked 2026-08-08.)
__pycache__/
*.pyc
